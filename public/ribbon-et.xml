<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="ribbon.OnAddinLoad">
    <ribbon startFromScratch="false">
        <tabs>
            <!-- 表格宿主：单开入口 + 跨行业高频常驻（设计定稿：ribbon=一键直达，面板=全集）
                 2026-10 扩展：+报表结论/一键美化（autoSend 一键）+ 文档安全▾（加密/解密/保密检查）
                 + 更多表格助手▾（高频带参配方收纳，点击预填） -->
            <tab id="tabAssistantEt" label="察元AI助理">
                <group id="groupAIAssistantEt" label="AI助手" autoScale="true">
                    <button id="btnAIAssistantEt" label="AI表格助手" onAction="ribbon.OnAction" getImage="ribbon.GetImage" size="large"/>
                    <button id="btnEtFormula" label="公式助手" onAction="ribbon.OnAction" getImage="ribbon.GetImage" size="large"/>
                    <button id="btnEtInsight" label="数据洞察" onAction="ribbon.OnAction" getImage="ribbon.GetImage" size="large"/>
                    <button id="btnEtChart" label="一键图表" onAction="ribbon.OnAction" getImage="ribbon.GetImage" size="large"/>
                    <button id="btnEtClean" label="数据清洗" onAction="ribbon.OnAction" getImage="ribbon.GetImage" size="large"/>
                    <button id="btnEtReport" label="报表结论" onAction="ribbon.OnAction" getImage="ribbon.GetImage" size="large"/>
                    <button id="btnEtBeautify" label="一键美化" onAction="ribbon.OnAction" getImage="ribbon.GetImage" size="large"/>
                    <menu id="menuEtSecurity" label="文档安全" getImage="ribbon.GetImage" size="large">
                        <button id="btnEtSecurityCheck" label="保密检查" onAction="ribbon.OnAction" getImage="ribbon.GetImage"/>
                        <button id="btnEtSecEncrypt" label="加密工作簿" onAction="ribbon.OnAction" getImage="ribbon.GetImage"/>
                        <button id="btnEtSecDecrypt" label="解密工作簿" onAction="ribbon.OnAction" getImage="ribbon.GetImage"/>
                    </menu>
                    <menu id="menuEtMore" label="更多表格助手" getImage="ribbon.GetImage" size="large">
                        <button id="btnEtMoreSort" label="排序汇总" onAction="ribbon.OnAction" getImage="ribbon.GetImage"/>
                        <button id="btnEtMoreMerge" label="多表合并汇总" onAction="ribbon.OnAction" getImage="ribbon.GetImage"/>
                        <button id="btnEtMoreDiff" label="两表对比差异" onAction="ribbon.OnAction" getImage="ribbon.GetImage"/>
                        <button id="btnEtMoreTranslate" label="表格翻译" onAction="ribbon.OnAction" getImage="ribbon.GetImage"/>
                        <button id="btnEtMoreMask" label="敏感信息脱敏" onAction="ribbon.OnAction" getImage="ribbon.GetImage"/>
                        <button id="btnEtMoreSplitCols" label="智能分列" onAction="ribbon.OnAction" getImage="ribbon.GetImage"/>
                        <button id="btnEtMoreSplitSheets" label="按列拆表" onAction="ribbon.OnAction" getImage="ribbon.GetImage"/>
                        <button id="btnEtMoreExtract" label="文档抽取成表" onAction="ribbon.OnAction" getImage="ribbon.GetImage"/>
                        <button id="btnEtMoreBattle" label="数据战报页" onAction="ribbon.OnAction" getImage="ribbon.GetImage"/>
                        <separator id="SepEtMore"/>
                        <button id="btnEtSettings" label="设置" onAction="ribbon.OnAction" getImage="ribbon.GetImage"/>
                    </menu>
                    <separator id="SepEtSettings"/>
                    <button id="btnEtSettingsTop" label="设置" onAction="ribbon.OnAction" getImage="ribbon.GetImage" size="large"/>
                </group>
            </tab>
        </tabs>
    </ribbon>
</customUI>
